generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  name         String
  role         String    @default("operator")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  processes    Process[] @relation("CreatedProcesses")
  uploads      File[]    @relation("UploadedFiles")
  auditEvents  AuditEvent[]
}

model Entidad {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique
  nombre   String
  nit      String?
  processes Process[]
  createdAt DateTime @default(now())
}

model Process {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  title     String
  status    String    @default("created")
  entidadId Int?
  createdBy Int
  deudorNombre    String?
  deudorDocumento String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  creator   User      @relation("CreatedProcesses", fields: [createdBy], references: [id])
  entidad   Entidad?  @relation(fields: [entidadId], references: [id])
  files     File[]
  analyses  Analysis[]
  partes    Parte[]
  credito   Credito?
  movimientos Movimiento[]
  cuotas    CuotaAmortizacion[]
  campos    ExtraccionCampo[]

  @@index([deudorDocumento])
}

model File {
  id           Int      @id @default(autoincrement())
  processId    Int
  originalName String
  storageKey   String   @unique
  mimeType     String
  originalMimeType String?
  converted    Boolean  @default(false)
  sizeBytes    Int
  sha256       String
  tipo         String?
  uploadedBy   Int
  createdAt    DateTime @default(now())
  process      Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  uploader     User     @relation("UploadedFiles", fields: [uploadedBy], references: [id])
  analyses     Analysis[]
  @@index([processId])
}

model Analysis {
  id           Int      @id @default(autoincrement())
  processId    Int
  fileId       Int?
  scope        String   @default("file")
  status       String   @default("pending")
  provider     String?
  model        String?
  result       Json?
  validated    Json?
  error        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  process      Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  file         File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([processId])
  @@index([status, createdAt])
}

model AuditEvent {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  resource   String
  resourceId Int?
  detail     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([userId, createdAt])
}

model Parte {
  id                Int      @id @default(autoincrement())
  processId         Int
  rol               String
  orden             Int      @default(0)
  tipoDocumento     String?
  numeroDocumento   String?
  nombreCompleto    String?
  fechaExpedicion   DateTime?
  lugarExpedicion   String?
  fechaNacimiento   DateTime?
  direccion         String?
  ciudad            String?
  departamento      String?
  telefono          String?
  celular           String?
  email             String?
  ocupacion         String?
  empresa           String?
  ingresosMensuales Decimal? @db.Decimal(18, 2)
  relacionDeudor    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  process           Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, rol])
  @@index([numeroDocumento])
}

model Credito {
  id                       Int      @id @default(autoincrement())
  processId                Int      @unique
  entidadId                Int?
  numeroCredito            String?
  numeroPagare             String?
  producto                 String?
  monto                    Decimal? @db.Decimal(18, 2)
  plazoMeses               Int?
  tasaEa                   Decimal? @db.Decimal(9, 4)
  tasaInteresCorriente     Decimal? @db.Decimal(9, 4)
  tasaInteresMora          Decimal? @db.Decimal(9, 4)
  fechaDesembolso          DateTime?
  fechaCorte               DateTime?
  fechaCausacion           DateTime?
  saldoCapital             Decimal? @db.Decimal(18, 2)
  totalInteresesCorrientes Decimal? @db.Decimal(18, 2)
  totalInteresesMora       Decimal? @db.Decimal(18, 2)
  totalSeguroVida          Decimal? @db.Decimal(18, 2)
  totalDeuda               Decimal? @db.Decimal(18, 2)
  diasMora                 Int?
  fechaUltimoPago          DateTime?
  valorUltimoPago          Decimal? @db.Decimal(18, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  process                  Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  movimientos              Movimiento[]
  cuotas                   CuotaAmortizacion[]

  @@index([numeroCredito])
}

model Movimiento {
  id          Int      @id @default(autoincrement())
  processId   Int
  creditoId   Int
  orden       Int      @default(0)
  documento   String?
  fecha       DateTime?
  descripcion String?
  total       Decimal? @db.Decimal(18, 2)
  capital     Decimal? @db.Decimal(18, 2)
  interes     Decimal? @db.Decimal(18, 2)
  mora        Decimal? @db.Decimal(18, 2)
  seguroVida  Decimal? @db.Decimal(18, 2)
  otros       Decimal? @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  credito     Credito  @relation(fields: [creditoId], references: [id], onDelete: Cascade)
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([creditoId, fecha])
}

model CuotaAmortizacion {
  id           Int      @id @default(autoincrement())
  processId    Int
  creditoId    Int
  numero       Int?
  fecha        DateTime?
  cuota        Decimal? @db.Decimal(18, 2)
  abonoCapital Decimal? @db.Decimal(18, 2)
  abonoInteres Decimal? @db.Decimal(18, 2)
  saldo        Decimal? @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  credito      Credito  @relation(fields: [creditoId], references: [id], onDelete: Cascade)
  process      Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([creditoId, numero])
}

model ExtraccionCampo {
  id          Int      @id @default(autoincrement())
  processId   Int
  analysisId  Int?
  fileId      Int?
  ruta        String
  clave       String
  valorTexto  String?  @db.Text
  valorNumero Decimal? @db.Decimal(18, 4)
  valorFecha  DateTime?
  valorBool   Boolean?
  valorJson   Json?
  createdAt   DateTime @default(now())
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, ruta])
  @@index([analysisId])
}
