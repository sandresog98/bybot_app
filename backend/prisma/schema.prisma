generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  name         String
  role         String    @default("operator")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  processes    Process[] @relation("CreatedProcesses")
  uploads      File[]    @relation("UploadedFiles")
  auditEvents  AuditEvent[]
}

model Process {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  title     String
  status    String    @default("created")
  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  creator   User      @relation("CreatedProcesses", fields: [createdBy], references: [id])
  files     File[]
  analyses  Analysis[]
}

model File {
  id           Int      @id @default(autoincrement())
  processId    Int
  originalName String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedBy   Int
  createdAt    DateTime @default(now())
  process      Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  uploader     User     @relation("UploadedFiles", fields: [uploadedBy], references: [id])
  analyses     Analysis[]
  @@index([processId])
}

model Analysis {
  id           Int      @id @default(autoincrement())
  processId    Int
  fileId       Int?
  status       String   @default("pending")
  provider     String?
  model        String?
  result       Json?
  validated    Json?
  error        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  process      Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  file         File?    @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([processId])
  @@index([status, createdAt])
}

model AuditEvent {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  resource   String
  resourceId Int?
  detail     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([userId, createdAt])
}
